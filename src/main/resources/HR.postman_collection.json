					"mode": "raw",
					"raw": "{\n    \"username\": \"nora\",\n    \"name\": \"Nora Weber\",\n    \"department\": \"People\",\n    \"role\": \"Recruiter\",\n    \"email\": \"nora@example.com\",\n    \"salary\": 52000,\n    \"address\": \"Berlin, Germany\"\n}",
					"options": {
						"raw": {
