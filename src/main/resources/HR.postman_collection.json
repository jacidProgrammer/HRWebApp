						"{{baseUrl}}"
					],
					"path": [
						"employees",
						"me"
					]
				},
				"description": "MANAGER, EMPLOYEE. 404 when your user has no employee record (e.g. manager). Stores the id in `employeeId`."
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 200) pm.collectionVariables.set('employeeId', pm.response.json().id);"
						]
					}
				}
			]
		},
