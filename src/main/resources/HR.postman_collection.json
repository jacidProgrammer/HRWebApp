{
	"info": {
		"_postman_id": "59f0366c-b621-4728-95d4-fc00b0c8b161",
		"name": "HR",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "13926674"
	},
	"item": [
		{
			"name": "Token",
			"protocolProfileBehavior": {
				"disabledSystemHeaders": {
					"content-type": true
				}
			},
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded",
						"type": "text"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "grant_type",
							"value": "password",
							"type": "text"
						},
						{
							"key": "client_id",
							"value": "hr-api-login",
							"type": "text"
						},
						{
							"key": "username",
							"value": "{{username}}",
							"type": "text"
						},
						{
							"key": "password",
							"value": "{{password}}",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{keycloakUrl}}/realms/hr-realm/protocol/openid-connect/token",
					"host": [
						"{{keycloakUrl}}"
					],
					"path": [
						"realms",
						"hr-realm",
						"protocol",
						"openid-connect",
						"token"
					]
				},
				"auth": {
					"type": "noauth"
				},
				"description": "Password grant against the demo realm (local demo only). Set the collection variable `username` to manager, jose, louisa, maria or lukas (password 1234). Stores the access token in `token`, which every other request uses."
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"pm.test('token issued', () => pm.expect(body.access_token).to.be.a('string'));",
							"pm.collectionVariables.set('token', body.access_token);"
						]
					}
				}
			]
		},
		{
			"name": "Employees",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/employees",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"employees"
					]
				},
				"description": "MANAGER, EMPLOYEE. Salary and address only for managers and for your own record. Stores louisa's id in `recipientId`."
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const louisa = pm.response.json().find(e => e.username === 'louisa');",
							"if (louisa) pm.collectionVariables.set('recipientId', louisa.id);"
						]
					}
				}
			]
		},
		{
			"name": "My employee record",
			"request": {
				"method": "GET",
				"header": [],
