          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"hr-api\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
